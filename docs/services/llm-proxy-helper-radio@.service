# One privileged helper process for one connection (radio class: listen to Wi-Fi frame headers through a USB adapter in monitor mode). ADR-0034, Constitution I.11 and I.16.
# The capability is held by this process only; the helper takes it off every thread that asks systemd a question and puts it back only for a
# verified action. The one setting that gates it is written by `scripts/install-helper.sh` into a root-owned drop-in:
#   HELPER_ACTIONS  the actions this unit may run (the third gate; the service cannot change it)
# The helper checks, from the host's own records, that the adapter it is asked to use is a USB device that carries neither the default route
# nor an SSH session, and puts it back in managed mode after every window, on every path. It sends no frame.
[Unit]
Description=LLM Proxy privileged helper (radio)

[Service]
ExecStart=@HELPER_BIN@ --class radio --actions ${HELPER_ACTIONS} --unit @SERVICE_UNIT@
# A fixed system account, not DynamicUser: measured on systemd 255, a DynamicUser process cannot ask systemd for the service's main process
# ("Transport endpoint is not connected"), and the caller check needs exactly that answer. The account has no shell, no home and no group
# but its own; the install script creates it.
User=llm-proxy-helper
Group=llm-proxy-helper
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET
# @system-service plus the three Landlock calls (the file jail). Measured on systemd 255: capget and capset, which the helper uses to put
# its one capability back for a verified action, are already in @system-service.
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# A window is at most 30 seconds plus the time to set the adapter up and put it back; this is the backstop.
RuntimeMaxSec=120
