[Unit]
Description=LLM Proxy Service
After=network-online.target
Wants=network-online.target

[Service]
# Dedicated unprivileged account. The backend and every agent-spawned child
# (shell sessions, workspaces) run as this user; it owns nothing outside the
# single root below.
User=llm-proxy
Group=llm-proxy
Environment=APP_ENV=production
# Single root (config, data, logs, DB). See backend/internal/platform/paths.
# Setting it here keeps the app OFF $HOME so ProtectHome can stay read-only.
Environment=LLM_PROXY_HOME=/var/lib/llm-proxy
WorkingDirectory=/var/lib/llm-proxy
ExecStart=/usr/local/bin/llm-proxy
# on-failure, not always: a config/permission error (like a read-only root)
# must trip the start limit instead of crash-looping forever.
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=5
KillMode=control-group
TimeoutStopSec=30

# --- Filesystem hardening -------------------------------------------------
# The ONLY writable location is the app root (ReadWritePaths). Everything the
# app writes — settings, DB, logs, workspaces/, workspace .sandbox runtime
# dirs — must live under /var/lib/llm-proxy. Set `workspaces_dir: workspaces`
# in settings.yml (relative paths resolve against this root).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/llm-proxy

# --- Kernel / capabilities / syscall hardening -----------------------------
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Go binaries are JIT-less; safe to enable. Remove only if a future embedded
# runtime needs executable-mapping memory.
MemoryDenyWriteExecute=true
# @system-service covers the backend's normal syscalls. The three Landlock
# syscalls are listed EXPLICITLY because the agent OS-sandboxing layer needs
# them and systemd's @system-service does not always include them: the
# filesystem-jail provider probes Landlock at startup (landlock_create_ruleset)
# and confines every agent child with landlock_add_rule + landlock_restrict_self.
# On a systemd whose @system-service predates Landlock, a non-allowlisted
# syscall is KILLED (SIGSYS -> journal "code=dumped, status=31/SYS", restart
# loop) rather than returned as an error, so the service dies at boot right
# after "Host Shell Manager initialized successfully". Listing syscalls already
# in @system-service is harmless. Verify with:
#   systemd-analyze syscall-filter @system-service | grep landlock
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# --- Memory / process limits (real cgroup v2 enforcement, plan Phase 3) -----
# MemoryMax bounds the whole service scope: backend + every agent-spawned
# shell/toolchain child AND any local llama-server the proxy launches as a
# child. A 35B Q4 model is ~20 GB, so a fixed low cap (the old 8G) makes
# llama.cpp thrash at MemoryHigh and never finish loading — worse on a
# shared-memory iGPU, where weights count against host RAM. Host-relative
# percentages leave room for model weights while still bounding the whole
# scope below total RAM (a runaway agent can no longer take the entire
# machine). MemoryMax is the OOM-kill ceiling; MemoryHigh throttles (memory
# reclaim) first. TasksMax caps fork-bombs per service WITHOUT the per-uid
# blast radius of RLIMIT_NPROC.
MemoryMax=85%
MemoryHigh=75%
TasksMax=512

# `--load-mode mlock` models: llama.cpp maps and locks weights, which needs
# RLIMIT_MEMLOCK — the empty CapabilityBoundingSet below means there is no
# CAP_IPC_LOCK to bypass it. Without this, mlock fails and prints
# "failed to mlock ... Cannot allocate memory. Try increasing RLIMIT_MEMLOCK".
LimitMEMLOCK=infinity

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
