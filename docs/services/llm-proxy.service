[Unit]
Description=LLM Proxy Service
After=network-online.target
Wants=network-online.target

[Service]
User=mikeathan
Group=mikeathan
WorkingDirectory=/home/mikeathan/dev/llm-proxy
Environment=APP_ENV=production
ReadWritePaths=/home/mikeathan/dev/llm-proxy

ExecStart=/home/mikeathan/dev/llm-proxy/llm-proxy
Restart=always
RestartSec=3

# Make sure it doesn't get killed when SSH ends
KillMode=process

# Hardening options
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Increase open files limit if model loading needs it
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
