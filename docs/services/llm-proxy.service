[Unit]
Description=LLM Proxy Service
After=network-online.target
Wants=network-online.target

[Service]
User=[USER]
Group=[USER]
Environment=APP_ENV=production
ReadWritePaths=/home/[USER]/llm-proxy
WorkingDirectory=/home/[USER]/llm-proxy/backend
ExecStart=/home/[USER]/llm-proxy/backend/llm-proxy
Restart=always
RestartSec=3
KillMode=control-group

# Hardening options
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Increase open files limit if model loading needs it
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
