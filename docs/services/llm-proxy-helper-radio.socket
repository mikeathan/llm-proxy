# The privileged helper's socket, radio class (ADR-0034). systemd listens here and starts one helper process per connection, so nothing
# privileged stays running. Installed by the operator with `sudo ./setup.sh helper --install radio`, never by the service. Only the service
# account can open it, and the helper then checks that the caller is the service's main process, not any other process of that account.
[Unit]
Description=LLM Proxy privileged helper socket (radio)

[Socket]
ListenStream=/run/llm-proxy-helper-radio.sock
SocketUser=root
SocketGroup=@SERVICE_GROUP@
SocketMode=0660
Accept=yes
MaxConnections=2

[Install]
WantedBy=sockets.target
