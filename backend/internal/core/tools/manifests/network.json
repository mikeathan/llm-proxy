{
  "tool_name": "network_tools",
  "version": "1.2",
  "description": "Perform scoped network operations like fetching remote resources or reading this machine's network address.",
  "runtime": {
    "fetch_url": {
      "description": "Download the content of a remote URL.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL to fetch."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "get_network_info": {
      "description": "Returns the local IP address and subnet mask of the host machine.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  },
  "guardrails": {
    "enabled": true,
    "allow_lan_access": true,
    "allow_internet_access": true,
    "blocked_domains": [
      "*.internal.company.com"
    ],
    "blocked_ips": [
      "127.0.0.1",
      "0.0.0.1",
      "169.254.169.254"
    ],
    "max_fetch_size_kb": 2048,
    "timeout_seconds": 30
  }
}
