{
  "tool_name": "execute_terminal_command",
  "version": "1.1",
  "description": "Execute a shell command on the host terminal and return the output.",
  "guardrails": {
    "enabled": true,
    "allowed_commands": [
      "ls",
      "pwd",
      "whoami",
      "uname",
      "nmap",
      "ping",
      "df",
      "uptime",
      "curl",
      "cat",
      "grep",
      "ip",
      "hostname",
      "ifconfig",
      "ping"
    ],
    "blocked_patterns": [
      "rm\\s+",
      "mv\\s+",
      "chmod\\s+",
      "sudo\\s+",
      "\u003e\\s*/",
      ";",
      "\u0026\u0026",
      "\\|\\|",
      "\\|",
      "\u0026",
      "\\$",
      "ssh\\s+",
      "passwd"
    ],
    "timeout_seconds": 60,
    "max_output_size_chars": 50000
  },
  "runtime": {
    "timeout_seconds": 60,
    "default_shell": "sh"
  }
}