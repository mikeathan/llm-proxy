{
  "tool_name": "system",
  "description": "System-level tools for error reporting.",
  "version": "1.0",
  "runtime": {
    "system_error": {
      "description": "Internal tool used by the system to report malformed tool calls back to the agent.",
      "parameters": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      }
    }
  },
  "guardrails": {
    "enabled": true
  }
}
