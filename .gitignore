# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# --- Build output -----------------------------------------------------------

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# The built service binary (scripts/build.sh)
llm-proxy

# Embedded admin UI build output (regenerated by `npm run build`)
backend/internal/transport/http/frontend_dist/*

# Test binary, built with `go test -c`
*.test

# --- Test and coverage artifacts --------------------------------------------

# Code coverage profiles and other test artifacts
*.out
coverage.*
coverage-summary.md
frontend/coverage/
*.coverprofile
profile.cov

# --- Dependencies and caches ------------------------------------------------

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Node dependencies
node_modules/

# Local Go build and module caches
.cache/
.gocache/
.gomodcache/*

# Python bytecode (scripts/*.py)
__pycache__/

# --- Secrets and local config -----------------------------------------------

# env files (ignore all variants; keep documented examples)
.env
.env.*
!.env.example
!.env.*.example

# Secrets / local config that may hold API keys (never commit)
**/secrets.json

# dev launcher env (generated by setup.sh)
.launch.env

# --- Runtime data and logs --------------------------------------------------

# Logs
llm-proxy.log
vitest-coverage.log

# Agent workspace files — default is relative to the executable/CWD.
workspaces/
backend/workspaces/*

# Generated run reports
backend/reports/*

# Runtime artifacts under backend/data (not part of the repo).
backend/data/registry.json
backend/data/secrets.json
backend/data/orchestrator.db*
backend/data/workspaces/*
backend/data/runs/*

# Sandbox scratch directory
.sandbox/

# --- Tool and editor state --------------------------------------------------

# Editor/IDE
# .idea/
# .vscode/

.DS_Store

# Aider chat/history files
.aider*

# Codebase-memory index
.codebase-memory/*

# Command Code worktrees and local state
.commandcode/*

# graphify knowledge-graph output
backend/graphify-out/*
graphify-out/*
